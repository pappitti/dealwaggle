# Copy values into your existing .env; do not overwrite existing credentials.
DEALWAGGLE_ENVIRONMENT=development
DEALWAGGLE_DATABASE_URL=sqlite:///./.data/dealwaggle.db
# Demo auth is opt-in. make demo-api enables it on loopback only.
DEALWAGGLE_DEMO_MODE=false
DEALWAGGLE_APP_URL=http://localhost:5173
DEALWAGGLE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Production identity: provision User.auth_subject to match the provider's sub.
DEALWAGGLE_JWT_ISSUER=
DEALWAGGLE_JWT_AUDIENCE=dealwaggle
DEALWAGGLE_JWT_JWKS_URL=

# Meta app secret signs POSTs; verify token is only for the GET handshake.
DEALWAGGLE_WHATSAPP_APP_SECRET=
DEALWAGGLE_WHATSAPP_VERIFY_TOKEN=
DEALWAGGLE_WHATSAPP_PHONE_NUMBER_ID=
DEALWAGGLE_RESEND_WEBHOOK_SECRET=
DEALWAGGLE_RESEND_API_KEY=
DEALWAGGLE_STRIPE_WEBHOOK_SECRET=
DEALWAGGLE_STRIPE_SECRET_KEY=
DEALWAGGLE_STRIPE_PRICE_ID=
