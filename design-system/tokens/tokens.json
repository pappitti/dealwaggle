{
  "$description": "DealWaggle design tokens, the single source of truth. Edit here, then run `node scripts/build-tokens.mjs` to regenerate tokens.css and tailwind-theme.css. Format follows the W3C Design Tokens draft; {a.b.c} values are references.",
  "color": {
    "honey": {
      "$type": "color",
      "50": { "$value": "#FFF8EB" },
      "100": { "$value": "#FEEFCB" },
      "200": { "$value": "#FDDD94" },
      "300": { "$value": "#FBC85A" },
      "400": { "$value": "#F8B536" },
      "500": { "$value": "#F5A524", "$description": "Brand honey. Fills, the bee, highlights. Never for text on light backgrounds." },
      "600": { "$value": "#DD880D" },
      "700": { "$value": "#B76909" },
      "800": { "$value": "#92520E", "$description": "Honey you can read: text and icons on light backgrounds (5.3:1 or better)." },
      "900": { "$value": "#78430F" },
      "950": { "$value": "#452205" }
    },
    "ink": {
      "$type": "color",
      "0": { "$value": "#FFFFFF" },
      "25": { "$value": "#FBF8F2", "$description": "Paper: the light app background." },
      "50": { "$value": "#F6F1E8" },
      "100": { "$value": "#EDE6DA" },
      "150": { "$value": "#E9E1D3" },
      "200": { "$value": "#DDD3C2" },
      "300": { "$value": "#C9BCA7" },
      "400": { "$value": "#A99E8D" },
      "450": { "$value": "#9A8E7C" },
      "500": { "$value": "#857A6A" },
      "600": { "$value": "#6B6153" },
      "700": { "$value": "#4F473C" },
      "750": { "$value": "#453E35" },
      "800": { "$value": "#2F2921" },
      "850": { "$value": "#26211B" },
      "900": { "$value": "#211C15", "$description": "Ink: text and line art on light backgrounds." },
      "925": { "$value": "#1E1A15" },
      "950": { "$value": "#15120E", "$description": "The dark app background." },
      "975": { "$value": "#100D0A" }
    },
    "moss": {
      "$type": "color",
      "50": { "$value": "#EEF7F0" },
      "100": { "$value": "#D5EDDB" },
      "300": { "$value": "#7CCB98" },
      "500": { "$value": "#2F8F55" },
      "600": { "$value": "#26774A" },
      "700": { "$value": "#1E5E3B" }
    },
    "ember": {
      "$type": "color",
      "50": { "$value": "#FFF2E8" },
      "100": { "$value": "#FFDFC7" },
      "300": { "$value": "#FFA26B" },
      "500": { "$value": "#E8590C" },
      "600": { "$value": "#C2470A" },
      "700": { "$value": "#9A3708" }
    },
    "berry": {
      "$type": "color",
      "50": { "$value": "#FDEEEE" },
      "100": { "$value": "#F9D5D5" },
      "300": { "$value": "#F28B85" },
      "500": { "$value": "#D6362F" },
      "600": { "$value": "#B42A24" },
      "700": { "$value": "#8E211C" }
    },
    "sky": {
      "$type": "color",
      "50": { "$value": "#EEF3FD" },
      "100": { "$value": "#D7E3FA" },
      "300": { "$value": "#8FB0F5" },
      "500": { "$value": "#3866D6" },
      "600": { "$value": "#2C52B3" },
      "700": { "$value": "#22408C" }
    }
  },
  "theme": {
    "$description": "Semantic colours. Components use only these, so light and dark switch together.",
    "light": {
      "$type": "color",
      "bg": { "$value": "{color.ink.25}" },
      "surface": { "$value": "{color.ink.0}" },
      "surface-sunken": { "$value": "{color.ink.50}" },
      "surface-hover": { "$value": "{color.ink.50}" },
      "surface-active": { "$value": "{color.ink.100}" },
      "border": { "$value": "{color.ink.150}" },
      "border-strong": { "$value": "{color.ink.200}" },
      "border-input": { "$value": "{color.ink.450}" },
      "text": { "$value": "{color.ink.900}" },
      "text-muted": { "$value": "{color.ink.600}" },
      "text-subtle": { "$value": "{color.ink.500}", "$description": "Placeholders and disabled text only." },
      "accent": { "$value": "{color.honey.500}" },
      "accent-hover": { "$value": "{color.honey.400}" },
      "accent-active": { "$value": "{color.honey.600}" },
      "accent-soft": { "$value": "{color.honey.50}" },
      "accent-soft-strong": { "$value": "{color.honey.100}" },
      "accent-text": { "$value": "{color.honey.800}" },
      "on-accent": { "$value": "{color.ink.900}" },
      "focus": { "$value": "{color.honey.700}" },
      "focus-ring": { "$value": "rgba(245, 165, 36, 0.35)" },
      "positive": { "$value": "{color.moss.600}" },
      "positive-soft": { "$value": "{color.moss.50}" },
      "positive-text": { "$value": "{color.moss.700}" },
      "caution": { "$value": "{color.ember.600}" },
      "caution-soft": { "$value": "{color.ember.50}" },
      "caution-text": { "$value": "{color.ember.700}" },
      "critical": { "$value": "{color.berry.600}" },
      "critical-soft": { "$value": "{color.berry.50}" },
      "critical-text": { "$value": "{color.berry.700}" },
      "on-critical": { "$value": "{color.ink.0}" },
      "info": { "$value": "{color.sky.600}" },
      "info-soft": { "$value": "{color.sky.50}" },
      "info-text": { "$value": "{color.sky.700}" },
      "inverse-bg": { "$value": "{color.ink.900}" },
      "inverse-text": { "$value": "{color.ink.25}" },
      "overlay": { "$value": "rgba(21, 18, 14, 0.48)" },
      "internal-stripe": { "$value": "rgba(33, 28, 21, 0.045)" }
    },
    "dark": {
      "$type": "color",
      "bg": { "$value": "{color.ink.950}" },
      "surface": { "$value": "{color.ink.925}" },
      "surface-sunken": { "$value": "{color.ink.975}" },
      "surface-hover": { "$value": "{color.ink.850}" },
      "surface-active": { "$value": "{color.ink.800}" },
      "border": { "$value": "{color.ink.800}" },
      "border-strong": { "$value": "{color.ink.750}" },
      "border-input": { "$value": "{color.ink.500}" },
      "text": { "$value": "{color.ink.50}" },
      "text-muted": { "$value": "{color.ink.400}" },
      "text-subtle": { "$value": "{color.ink.500}" },
      "accent": { "$value": "{color.honey.500}" },
      "accent-hover": { "$value": "{color.honey.400}" },
      "accent-active": { "$value": "{color.honey.600}" },
      "accent-soft": { "$value": "rgba(245, 165, 36, 0.12)" },
      "accent-soft-strong": { "$value": "rgba(245, 165, 36, 0.22)" },
      "accent-text": { "$value": "{color.honey.300}" },
      "on-accent": { "$value": "{color.ink.900}" },
      "focus": { "$value": "{color.honey.400}" },
      "focus-ring": { "$value": "rgba(245, 165, 36, 0.4)" },
      "positive": { "$value": "{color.moss.300}" },
      "positive-soft": { "$value": "rgba(47, 143, 85, 0.18)" },
      "positive-text": { "$value": "{color.moss.300}" },
      "caution": { "$value": "{color.ember.300}" },
      "caution-soft": { "$value": "rgba(232, 89, 12, 0.18)" },
      "caution-text": { "$value": "{color.ember.300}" },
      "critical": { "$value": "{color.berry.500}" },
      "critical-soft": { "$value": "rgba(214, 54, 47, 0.18)" },
      "critical-text": { "$value": "{color.berry.300}" },
      "on-critical": { "$value": "{color.ink.0}" },
      "info": { "$value": "{color.sky.300}" },
      "info-soft": { "$value": "rgba(56, 102, 214, 0.2)" },
      "info-text": { "$value": "{color.sky.300}" },
      "inverse-bg": { "$value": "{color.ink.50}" },
      "inverse-text": { "$value": "{color.ink.900}" },
      "overlay": { "$value": "rgba(0, 0, 0, 0.6)" },
      "internal-stripe": { "$value": "rgba(246, 241, 232, 0.045)" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Bricolage Grotesque", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Headings, numbers in hero spots, the wordmark." },
      "sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"], "$description": "All UI and reading text." },
      "mono": { "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "type": {
    "$type": "typography",
    "$description": "Text styles. Each becomes a font shorthand (--dw-type-*), a tracking value, and a .dw-<name> class in base.css.",
    "display": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "48px", "lineHeight": "52px", "fontWeight": 700, "letterSpacing": "-0.025em" } },
    "title-1": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "32px", "lineHeight": "38px", "fontWeight": 700, "letterSpacing": "-0.02em" } },
    "title-2": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "24px", "lineHeight": "30px", "fontWeight": 650, "letterSpacing": "-0.015em" } },
    "title-3": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "lineHeight": "24px", "fontWeight": 600, "letterSpacing": "-0.01em" } },
    "body-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400, "letterSpacing": "-0.006em" } },
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400, "letterSpacing": "-0.003em" } },
    "label": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 500, "letterSpacing": "0em" } },
    "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 400, "letterSpacing": "0.002em" } },
    "overline": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "lineHeight": "16px", "fontWeight": 600, "letterSpacing": "0.08em" } },
    "mono": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "13px", "lineHeight": "20px", "fontWeight": 400, "letterSpacing": "0em" } }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px grid. Names match Tailwind's spacing scale (space-4 = 16px).",
    "0": { "$value": "0px" },
    "0.5": { "$value": "2px" },
    "1": { "$value": "4px" },
    "1.5": { "$value": "6px" },
    "2": { "$value": "8px" },
    "2.5": { "$value": "10px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "6px" },
    "md": { "$value": "10px", "$description": "Buttons, inputs, small cards." },
    "lg": { "$value": "14px", "$description": "Cards and panels." },
    "xl": { "$value": "20px", "$description": "Modals and large surfaces." },
    "full": { "$value": "9999px" }
  },
  "size": {
    "$type": "dimension",
    "control-sm": { "$value": "28px" },
    "control-md": { "$value": "36px" },
    "control-lg": { "$value": "44px", "$description": "Also the minimum touch target on mobile." },
    "sidebar": { "$value": "248px" },
    "topbar": { "$value": "56px" },
    "content-max": { "$value": "1200px" },
    "reading-max": { "$value": "680px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "CSS box-shadow strings, warm-tinted in light mode.",
    "light": {
      "sm": { "$value": "0 1px 2px rgba(33, 28, 21, 0.06), 0 1px 1px rgba(33, 28, 21, 0.04)" },
      "md": { "$value": "0 2px 4px rgba(33, 28, 21, 0.04), 0 6px 16px rgba(33, 28, 21, 0.08)" },
      "lg": { "$value": "0 4px 8px rgba(33, 28, 21, 0.06), 0 16px 40px rgba(33, 28, 21, 0.14)" }
    },
    "dark": {
      "sm": { "$value": "0 1px 2px rgba(0, 0, 0, 0.4)" },
      "md": { "$value": "0 2px 4px rgba(0, 0, 0, 0.35), 0 8px 20px rgba(0, 0, 0, 0.4)" },
      "lg": { "$value": "0 4px 8px rgba(0, 0, 0, 0.4), 0 20px 48px rgba(0, 0, 0, 0.55)" }
    }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "80ms" },
    "fast": { "$value": "140ms", "$description": "Hover and press feedback." },
    "base": { "$value": "220ms", "$description": "Panels, popovers, toasts entering." },
    "slow": { "$value": "360ms" },
    "dance": { "$value": "3s", "$description": "One full waggle dance (the loader)." }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "enter": { "$value": [0, 0, 0.2, 1] },
    "exit": { "$value": [0.4, 0, 1, 1] },
    "buzz": { "$value": [0.34, 1.56, 0.64, 1], "$description": "Small overshoot for moments of delight (a toast landing, a share confirmed). Use sparingly." }
  },
  "z": {
    "$type": "number",
    "dropdown": { "$value": 1000 },
    "sticky": { "$value": 1100 },
    "overlay": { "$value": 1200 },
    "modal": { "$value": 1300 },
    "toast": { "$value": 1400 },
    "tooltip": { "$value": 1500 }
  }
}
